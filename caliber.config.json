{
  "schema": 1,
  "validation": {
    "caliber": {
      "windows": [
        "go",
        "run",
        "./cmd/gpui-dev",
        "test",
        "--caliber-root",
        "{candidate}",
        "--allow-caliber-revision"
      ],
      "unix": [
        "go",
        "run",
        "./cmd/gpui-dev",
        "test",
        "--caliber-root",
        "{candidate}",
        "--allow-caliber-revision"
      ]
    }
  },
  "diagnostics": {
    "required_tools": [
      "git",
      "go",
      "cargo",
      "rustc"
    ],
    "caliber_library": {
      "windows": "frontends/gpui/build/caliber_ffi.dll",
      "macos": "frontends/gpui/build/libcaliber_ffi.dylib",
      "linux": "frontends/gpui/build/libcaliber_ffi.so"
    },
    "requested_abi": 1
  }
}
