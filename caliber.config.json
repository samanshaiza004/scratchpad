{
  "schema": 1,
  "validation": {
    "caliber": {
      "windows": [
        "go",
        "run",
        "./cmd/alicorn-dev",
        "test",
        "--caliber-root",
        "{candidate}",
        "--allow-caliber-revision"
      ], 
      "unix": [
        "go",
        "run",
        "./cmd/alicorn-dev",
        "test",
        "--caliber-root",
        "{candidate}",
        "--allow-caliber-revision"
      ]
    },
    "alicorn": {
      "windows": [
        "go",
        "run",
        "./cmd/alicorn-dev",
        "test",
        "--alicorn-root",
        "{candidate}",
        "--allow-alicorn-revision",
        "--out",
        "out/alicorn-caliber-validation"
      ],
      "unix": [
        "go",
        "run",
        "./cmd/alicorn-dev",
        "test",
        "--alicorn-root",
        "{candidate}",
        "--allow-alicorn-revision",
        "--out",
        "out/alicorn-caliber-validation"
      ]
    }
  },
  "diagnostics": {
    "required_tools": [
      "git",
      "go",
      "cargo",
      "rustc"
    ],
    "caliber_library": {
      "windows": "out/alicorn/caliber_ffi.dll",
      "macos": "out/alicorn/libcaliber_ffi.dylib",
      "linux": "out/alicorn/libcaliber_ffi.so"
    },
    "requested_abi": 1
  }
}
