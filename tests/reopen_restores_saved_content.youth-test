fixture file-hex "note.md" "efbbbf48656c6c6f0d0a"
grant document "note.md"
mount
expect editor text document "Hello\r\n"

type document "Preserved"
key "s" +primary
expect file-hex "note.md" "efbbbf48656c6c6f0d0a507265736572766564"

restart
expect editor text document "Hello\r\nPreserved"
expect editor dirty document false
