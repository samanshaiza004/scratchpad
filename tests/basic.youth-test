fixture file "note.md" "Hello"
grant document "note.md"
mount
expect text filename "note.md"
expect text status "Saved"
expect editor text document "Hello"
expect editor dirty document false

type document " world"
expect editor text document "Hello world"
expect editor dirty document true
expect text status "Unsaved changes"

activate save
expect file "note.md" "Hello world"
expect editor dirty document false
expect text status "Saved"

restart
expect editor text document "Hello world"
expect editor dirty document false
expect text status "Saved"
