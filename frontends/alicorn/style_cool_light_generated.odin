scratchpad_cool_light_theme_materials :: [0]alicorn.Style_Material_Definition{
}

scratchpad_cool_light_theme_destroy :: proc(value: ^alicorn.Style_Theme, allocator := context.allocator) {
    if value == nil { return }
    // Provenance strings are static generated literals; only their slices are owned.
    delete(value.color_tokens, allocator)
    delete(value.length_tokens, allocator)
    delete(value.extension_color_roles, allocator)
    delete(value.extension_length_roles, allocator)
    delete(value.color_token_provenance, allocator)
    delete(value.length_token_provenance, allocator)
    delete(value.extension_color_role_provenance, allocator)
    delete(value.extension_length_role_provenance, allocator)
    value.color_tokens = nil
    value.length_tokens = nil
    value.extension_color_roles = nil
    value.extension_length_roles = nil
    value.color_token_provenance = nil
    value.length_token_provenance = nil
    value.extension_color_role_provenance = nil
    value.extension_length_role_provenance = nil
}
